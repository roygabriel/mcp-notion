# Notion MCP Server Configuration

# Your Notion Integration Token (required)
# Create an integration at: https://www.notion.so/my-integrations
# Copy the "Internal Integration Token" (starts with "secret_")
NOTION_API_TOKEN=secret_your_integration_token_here

# Optional: Notion API version (default: 2022-06-28)
# Only change if you need a specific API version
NOTION_API_VERSION=2022-06-28

# Optional: Request timeout in seconds (default: 30)
# Increase if you experience timeout errors
NOTION_TIMEOUT=30

# IMPORTANT SETUP STEPS:
# 1. Create an integration at https://www.notion.so/my-integrations
# 2. Copy the Integration Token and paste it above
# 3. Share your pages/databases with the integration:
#    - Open page in Notion
#    - Click "..." menu → "Add connections"
#    - Select your integration
# 4. Without sharing, you'll get "object not found" errors!
